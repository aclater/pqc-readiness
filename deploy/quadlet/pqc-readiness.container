# pqc-readiness systemd quadlet — runs the probe periodically and writes
# the JSON report to /var/lib/pqc-readiness/ on the host.
#
# Install:
#   sudo cp pqc-readiness.container /etc/containers/systemd/
#   sudo cp pqc-readiness.timer     /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pqc-readiness.timer
#
# This unit is one-shot; it is invoked by pqc-readiness.timer (sibling
# file) on whatever cadence the operator chooses.  The container is
# rootless-friendly but in practice will need to read /proc, /sys, /dev,
# /etc — host-mounted read-only — to give an accurate report, so it is
# typically deployed as a system-mode quadlet.
#
# Pinning: in production pin Image= by digest for supply-chain
# reproducibility.  Each release's container-images.txt asset lists the
# digests; verify the cosign signature before rolling a new one out:
#   Image=ghcr.io/aclater/pqc-readiness@sha256:<digest>

[Unit]
Description=PQC readiness probe (one-shot)
Documentation=https://github.com/aclater/pqc-readiness

[Container]
# Default image is the published Red Hat UBI 10 release image
# (Containerfile.ubi10).  For Debian/Ubuntu fleets use the
# 2.2.0-debian tag (Containerfile.debian) instead, or 2.2.0-ubi8 for
# EL8 — the runtime semantics are identical: same script, same
# flags, same JSON schema, same UID 1001, same /var/lib/pqc-readiness
# output volume layout.
Image=ghcr.io/aclater/pqc-readiness:2.4.0
ContainerName=pqc-readiness
PodmanArgs=--pid=host

# Read-only host filesystem mounts.  The probe never writes to /proc,
# /sys, /dev, /etc — only to its writable Volume below.  No `,Z` on the
# system mounts: SELinux refuses to relabel /proc and /sys.  The host
# paths keep their existing labels and the container reads them with
# its container_t domain via the rule below.
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro
Volume=/dev:/host/dev:ro
Volume=/etc:/host/etc:ro
# Host /usr, read-only (#187).  One mount covers /usr/lib/os-release
# (detect_os; /etc/os-release symlinks to it on most distros), the
# crypto-policies back-ends in /usr/share/crypto-policies (#104), and
# SUSE's vendor sshd config in /usr/etc/ssh (#105).  Narrower mounts don't
# work on every host: podman refuses a missing bind-mount source, and
# /usr/etc/ssh and /usr/share/crypto-policies only exist on some distros.
# The probe only reads the /usr paths in _platform._HOST_NAMESPACES.
Volume=/usr:/host/usr:ro
# Host rpm database for --scan-packages / NSS version (#125).  /var/lib/rpm
# is a relative symlink to /usr/lib/sysimage/rpm on EL10 / Fedora / SUSE;
# the bind mount follows it, so this one mount covers every layout.
Volume=/var/lib/rpm:/host/var/lib/rpm:ro
Volume=/var/lib/pqc-readiness:/var/lib/pqc-readiness:rw,Z

# SecurityLabelDisable is required because the container_t domain does
# not have read access to the host's /proc and /sys labels by default.
# This is read-only host inspection — no writes are performed against
# the labeled host filesystem, and all four mounts are :ro.  See ADR
# (TBD) for the specific allowed/denied operations and the rationale
# for not creating a custom SELinux policy module for a probe tool.
SecurityLabelDisable=true

# Run the probe with --bench, --save (writes timestamped JSON to
# /var/lib/pqc-readiness inside the container, which is bind-mounted
# from the host), and --host-mount so detection sees host state.
Exec=--host-mount /host --bench --seconds 1 --save --quiet

# Prometheus metrics (#140): a quadlet takes one Exec, and --save and
# --output are mutually exclusive, so export metrics from a sibling unit.
# Copy this file to pqc-readiness-prom.container and change it to:
#   Volume=/var/lib/node_exporter/textfile_collector:/textfile:rw,z
#   Exec=--host-mount /host --prometheus --output /textfile/pqc_readiness.prom
# (lowercase ,z: the directory is shared with node_exporter's container, so
# it needs the shared SELinux label, not the private one ,Z gives).  Run
# node_exporter with --collector.textfile.directory pointing at that
# directory.  --output replaces the file atomically, as the collector needs.

# Resource caps.  Numpy triad probe uses ~384 MB transiently.
Memory=512M
CPUQuota=200%

# Run as the image's USER 1001.
User=1001

# No network needed: the probe is purely local.
Network=none

# Read-only root filesystem; only /var/lib/pqc-readiness is writable.
ReadOnly=true
Tmpfs=/tmp:size=64M,mode=1777

# AutoUpdate is opt-in — operator must explicitly accept image bumps.
# Uncomment once a published tag/digest scheme is settled:
# AutoUpdate=registry

[Service]
Type=oneshot

[Install]
WantedBy=multi-user.target
