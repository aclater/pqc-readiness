{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "title": "PQC readiness (fleet)",
  "uid": "pqc-readiness-fleet",
  "description": "Fleet view of pqc-readiness --prometheus metrics collected by node_exporter's textfile collector. See docs/prometheus.md.",
  "tags": ["pqc", "crypto"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-7d", "to": "now"},
  "refresh": "5m",
  "panels": [
    {
      "id": 1, "type": "piechart", "title": "Hosts by readiness tier",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "count by (tier) (pqc_readiness_verdict_tier == 1)", "legendFormat": "{{tier}}", "instant": true}]
    },
    {
      "id": 2, "type": "stat", "title": "Hosts offering hybrid TLS key exchange",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "avg(pqc_readiness_hybrid_kex_available{protocol=\"tls\"})", "instant": true}]
    },
    {
      "id": 3, "type": "stat", "title": "Hosts offering hybrid SSH key exchange",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "avg(pqc_readiness_hybrid_kex_available{protocol=\"ssh\"})", "instant": true}]
    },
    {
      "id": 4, "type": "stat", "title": "Hosts needing hardware replacement",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(pqc_readiness_replace_required)", "instant": true}]
    },
    {
      "id": 5, "type": "stat", "title": "Stale reports (older than 2 days)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "count(time() - pqc_readiness_last_run_timestamp_seconds > 2 * 86400) or vector(0)", "instant": true}]
    },
    {
      "id": 6, "type": "bargauge", "title": "CNSA 2.0 status",
      "gridPos": {"x": 8, "y": 4, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "count by (status) (pqc_readiness_cnsa_2_0_status == 1)", "legendFormat": "{{status}}", "instant": true}]
    },
    {
      "id": 7, "type": "bargauge", "title": "Trust-store certificates by category (fleet total)",
      "gridPos": {"x": 16, "y": 4, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (category) (pqc_readiness_trust_store_certificates)", "legendFormat": "{{category}}", "instant": true}]
    },
    {
      "id": 8, "type": "table", "title": "Per-host tier",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 10},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "pqc_readiness_verdict_tier == 1", "format": "table", "instant": true}]
    }
  ]
}
