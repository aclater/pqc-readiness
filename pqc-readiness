#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# pqc-readiness wrapper launcher.
#
# Why this exists: pqc-readiness uses modern Python (3.9+) type-hint
# syntax (PEP 604 unions, builtin generics).  RHEL 8 / Rocky 8 /
# AlmaLinux 8 ship Python 3.6 as the default `python3`, which cannot
# parse the script — it fails at import with `SyntaxError: future
# feature annotations is not defined`.  Customers running this on EL8
# fleets need an actionable signal, not a Python traceback.
#
# What this does: search PATH for the highest-version python3.x
# available (3.13 → 3.9, then `python3`, then `python`), exec the
# zipapp (or the package from a checkout) with that interpreter, and pass all arguments through.  If no Python
# 3.9+ is on PATH, print install guidance for the host family
# (SUSE, RHEL 8 family, Debian/Ubuntu) and exit 127.
#
# Co-located with pqc-readiness.pyz: the wrapper is shipped in the
# container images (UBI 10 and Debian 12-slim) at the same path so the
# user's invocation form does not change between distros.
#
# Exit codes: whatever pqc-readiness returns under the chosen
# interpreter, or 127 if no usable interpreter is found.  The wrapper
# itself does not consume any flags; everything after the program name
# is passed through to the script.

set -e

# Resolve the wrapper's own location so we can find the zipapp / package
# next to it.  $0 may be an absolute path, a relative path, or a bare
# name resolved via PATH; handle all three.
case $0 in
    /*) self=$0 ;;
    */*) self=$(pwd)/$0 ;;
    *) self=$(command -v -- "$0" 2>/dev/null || printf '%s' "$0") ;;
esac
# Resolve to an absolute directory; suppress cd / dirname stderr so a
# stripped-down PATH (a handful of test harnesses do this) gets a clean
# error from the explicit existence check below rather than a noisy
# `cd: null directory` from the resolver.
SCRIPT_DIR=$(cd "$(dirname -- "$self" 2>/dev/null)" 2>/dev/null && pwd) || SCRIPT_DIR=

# What to run (#80): the single-file zipapp next to this launcher (the
# deployed layout), else the `pqc_readiness/` package next to it (a git
# checkout), run as `python -m pqc_readiness` with that directory on
# PYTHONPATH.  The zipapp wins when both are present.
PYZ="$SCRIPT_DIR/pqc-readiness.pyz"
PKG="$SCRIPT_DIR/pqc_readiness"
if [ -n "$SCRIPT_DIR" ] && [ -f "$PYZ" ]; then
    MODE=pyz
elif [ -n "$SCRIPT_DIR" ] && [ -f "$PKG/__main__.py" ]; then
    MODE=package
else
    printf 'pqc-readiness: cannot locate pqc-readiness.pyz or the pqc_readiness/ package next to this launcher\n' >&2
    printf '  launcher: %s\n' "$self" >&2
    printf '  expected: %s\n' "${SCRIPT_DIR:-<unresolved>}/pqc-readiness.pyz" >&2
    exit 2
fi

# Returns 0 if $1 is on PATH and reports a Python version >= 3.9.
# Uses the interpreter itself to query its version so we trust the
# answer regardless of how the binary is named.
is_py_39_plus() {
    cmd=$1
    command -v -- "$cmd" >/dev/null 2>&1 || return 1
    ver=$("$cmd" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null) || return 1
    major=${ver%%.*}
    minor=${ver#*.}
    [ "$major" = "3" ] || return 1
    # POSIX [ -ge ] requires integers; redirect stderr so a non-numeric
    # minor (e.g. "9a0" from a pre-release) silently returns false
    # rather than printing a shell error.
    [ "$minor" -ge 9 ] 2>/dev/null
}

# Try explicit minor-version names first, newest to oldest, then the
# generic `python3` and `python` shims.  Explicit names match the
# RHEL 8 AppStream module binaries (python3.9, python3.11, python3.12)
# directly — installing the module exposes them on PATH without
# touching the system `python3` symlink.
for candidate in python3.13 python3.12 python3.11 python3.10 python3.9 python3 python; do
    if is_py_39_plus "$candidate"; then
        if [ "$MODE" = pyz ]; then
            exec "$candidate" "$PYZ" "$@"
        fi
        PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$candidate" -m pqc_readiness "$@"
    fi
done

# No usable interpreter: print install guidance for this host's family
# (#127).  ID / ID_LIKE are read in a subshell with shell builtins only,
# so a stripped PATH still works and os-release variables cannot leak
# into this script.  PQC_READINESS_OS_RELEASE overrides the file for
# tests.
os_family() {
    for f in "${PQC_READINESS_OS_RELEASE:-}" /etc/os-release /usr/lib/os-release; do
        [ -n "$f" ] && [ -r "$f" ] || continue
        ids=$( . "$f" 2>/dev/null; printf ' %s %s ' "${ID:-}" "${ID_LIKE:-}" )
        case $ids in
            *" suse "*|*" sles "*|*" opensuse"*) echo suse; return ;;
            *" rhel "*|*" centos "*|*" fedora "*) echo rhel; return ;;
            *" debian "*|*" ubuntu "*) echo debian; return ;;
        esac
        echo other
        return
    done
    echo other
}

cat >&2 <<'EOF'
pqc-readiness: no Python 3.9+ interpreter found on PATH.

This tool requires Python 3.9 or newer; older interpreters cannot parse
the modern type-hint syntax it uses.
EOF

case $(os_family) in
suse)
    cat >&2 <<'EOF'

SLES 15 and openSUSE Leap 15 ship Python 3.6 as `python3`.  Install a
newer interpreter alongside it (the system python3 is left untouched),
then re-run this launcher, which finds `python3.11` automatically:

    sudo zypper --gpg-auto-import-keys ref
    sudo zypper -n in python311
    /path/to/pqc-readiness [flags]
EOF
    ;;
rhel)
    cat >&2 <<'EOF'

On RHEL 8, Rocky Linux 8, or AlmaLinux 8 the default `python3` is 3.6
(some stock cloud images have no `python3` at all, only
/usr/libexec/platform-python 3.6).  Enable the AppStream `python39`
module (or, on EL 8.8+, install `python3.11`), then re-run this
launcher:

    sudo dnf module install -y python39
    /path/to/pqc-readiness [flags]

On RHEL / Rocky / AlmaLinux 9+ and Fedora, `python3` is already 3.9+;
install it if a minimal image omits it: `sudo dnf install -y python3`.
EOF
    ;;
debian)
    cat >&2 <<'EOF'

Debian 11+ and Ubuntu 22.04+ ship Python 3.9 or newer as `python3`:

    sudo apt-get install -y python3
    /path/to/pqc-readiness [flags]
EOF
    ;;
*)
    cat >&2 <<'EOF'

Install Python 3.9 or newer with your distribution's package manager.
On RHEL 8 family hosts that is the AppStream module
(`sudo dnf module install -y python39`); on SLES / openSUSE Leap 15 it
is `sudo zypper -n in python311`.
EOF
    ;;
esac

cat >&2 <<'EOF'

You can also invoke any 3.9+ interpreter directly against the zipapp:

    python3.11 /path/to/pqc-readiness.pyz [flags]
EOF
exit 127
